# Copy to .env and fill in. Never commit .env.

# --- OpenAI: the fact-check model + title embeddings ---
OPENAI_API_KEY=
# Optional. Model for the fact check (default gpt-4o-mini):
# OPENAI_MODEL=gpt-4.1-mini
# Optional, same names as Shortly-email-agent (FACT_CHECK_MODEL overrides OPENAI_MODEL):
# FACT_CHECK_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small
# FACT_CHECK_ENABLED=true

# --- PIX news (Supabase project "PixAgent") — server-side only ---
# pix_posts has no anon read policy, so the service-role key is required.
PIX_SUPABASE_URL=https://coggfnbqqyiqfsxvtaym.supabase.co
PIX_SUPABASE_SERVICE_ROLE_KEY=

# --- Shortly-email-agent project: other outlets' coverage for corroboration ---
# The PUBLISHABLE (public) key: row-level security limits it to approved/sent
# articles, the same rows Shortly's public site shows.
SHORTLY_SUPABASE_URL=https://ygxdrphajvrbjcaxhvcn.supabase.co
SHORTLY_SUPABASE_PUBLISHABLE_KEY=

# --- WhatsApp chatbot API (/api/v1/chat) ---
# Callers send it as "Authorization: Bearer <key>" or "X-API-Key: <key>".
# Make a long random one, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CHAT_API_KEY=
